    {
      "parameters": {
        "jsCode": "// Check the agent sent everything before we touch the table\nconst input = $('When Executed by Another Workflow').first().json;\nconst contact = String(input.contact || '').trim();\nconst name = String(input.name || '').trim();\nconst notes = String(input.notes || '').trim();\n\nif (!contact || !name) {\n  return [{ json: {\n    ok: false,\n    error: 'Missing contact or name. Reuse the name and number the customer already gave in this conversation, then call again with contact, name, and notes.'\n  } }];\n}\n\nreturn [{ json: { ok: true, contact, name, notes } }];"
