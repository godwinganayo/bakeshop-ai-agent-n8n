        "jsCode": "// Check the agent sent a real order ID and the customer's contact\nconst input = $('When Executed by Another Workflow').first().json;\nconst contact = String(input.contact || '').trim();\nconst orderId = Number(input.order_id);\n\nif (!contact || !Number.isInteger(orderId) || orderId <= 0) {\n  return [{ json: { ok: false, error: 'Need contact and a numeric order_id (from Tool get my orders). Call again with both.' } }];\n}\nreturn [{ json: { ok: true, contact, order_id: orderId } }];"
      },
