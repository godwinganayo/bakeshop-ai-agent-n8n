        "jsCode": "// Tell the agent whether a matching order was actually cancelled\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nconst { order_id, contact } = $('Check').first().json;\n\nif (rows.length === 0) {\n  return [{ json: { ok: false, error: `Order ${order_id} was not found for this contact, so nothing was cancelled.` } }];\n}\nreturn [{ json: { ok: true, cancelled: true, order_id } }];"
